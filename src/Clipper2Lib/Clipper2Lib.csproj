<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Clipper2Lib</RootNamespace>
    <AssemblyName>Clipper2Lib</AssemblyName>
    <PackageId>Clipper2Sharp</PackageId>
    <Title>Clipper2Sharp</Title>
    <Description>Polygon Clipping and Offsetting library - a from scratch C# port of the Clipper2 C++ implementation. Fully managed C#, platform independent (Windows, Linux, macOS, WebAssembly), no P/Invoke, no native dependency, no unsafe code, no NuGet dependencies.</Description>
    <PackageTags>geometry;polygon;clipping;inflate;intersection;union;difference;offsetting;boolean-operations</PackageTags>
    <!-- the interactive demo of this package (running as WebAssembly) -->
    <PackageProjectUrl>https://dimq1.github.io/Clipper2Sharp/</PackageProjectUrl>
    <!-- the sources of this package, i.e. the port, not the original repository -->
    <RepositoryUrl>https://github.com/DimQ1/Clipper2Sharp</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
  </PropertyGroup>

  <PropertyGroup>
    <!-- symbols go to nuget.org next to the package (dotnet nuget push *.snupkg) -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

  <ItemGroup>
    <!-- the repository README is the package readme (shown on nuget.org) -->
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
