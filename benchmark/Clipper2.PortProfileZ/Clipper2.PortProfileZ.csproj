<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- The golden output check for the Z-coordinate flavour (Clipper2ZLib). -->
    <OutputType>Exe</OutputType>
    <RootNamespace>Clipper2.PortProfileZ</RootNamespace>
    <AssemblyName>Clipper2.PortProfileZ</AssemblyName>
    <IsPackable>false</IsPackable>
    <!-- -p:GateFramework=net10.0 runs this driver against the net10.0 assembly
         the package ships (the default is the repository's framework) -->
    <TargetFramework Condition="'$(GateFramework)' != ''">$(GateFramework)</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Clipper2ZLib\Clipper2ZLib.csproj" />
  </ItemGroup>

</Project>
